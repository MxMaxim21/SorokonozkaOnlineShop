<Page x:Class="SorokonozkaApp.View.Showcase.ShowPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SorokonozkaApp.View.Showcase"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Каталог"
      Background="#FFF"
      Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
            
            <Button Grid.Column="0" Name="BtnClose" Content="Выход" HorizontalAlignment="Left"
                    VerticalAlignment="Center" Click="BtnClose_Click" Margin="5"/>
            <Button Grid.Column="1" Name="BtnCart" Content="Корзина" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Click="BtnCart_Click" Margin="5"/>
            </Grid>
        </StackPanel>

        <ListView Grid.Row="1" Name="LViewShoes" ScrollViewer.HorizontalScrollBarVisibility="Hidden">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="5"
                            Background="#FFF" Margin="5" Padding="10" Width="900">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!--Photo-->
                                <ColumnDefinition Width="Auto"/> <!--Title-->
                                <ColumnDefinition Width="Auto"/> <!--Price-->
                                <ColumnDefinition Width="Auto"/> <!--Count-->
                                <ColumnDefinition Width="Auto"/> <!--Button-->
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Grid.Row="0" Width="50" Height="50" BorderBrush="#AAA"
                                    BorderThickness="1" Background="#AAA"
                                    VerticalAlignment="Center" HorizontalAlignment="Left">
                                <Image Name="ImgPreview" Stretch="UniformToFill"/>
                            </Border>

                            <TextBlock Grid.Column="1" FontSize="14"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold">
                                <Run Text="{Binding Title}"/>
                                <Run Text="|"/>
                            </TextBlock>

                            <TextBlock Grid.Column="2" FontSize="14"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold">
                                <Run Text="{Binding Price}"/>
                                <Run Text="|"/>
                            </TextBlock>

                            <TextBlock Grid.Column="3" FontSize="14"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold">
                                <Run Text="{Binding Count}"/>
                                <Run Text="|"/>
                            </TextBlock>

                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
