<Page x:Class="SorokonozkaApp.View.Shop.ShowPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SorokonozkaApp.View.Shop"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Каталог"
      Background="#FFF"
      Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

            <Button Name="BtnCart" Grid.Column="1"  Content="Корзина" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Click="BtnCart_Click" Margin="5"
                    Visibility="{Binding DataContext.AdminVisibility, RelativeSource={RelativeSource AncestorType=Page}}"/>

        <ListView Grid.Row="1" Grid.ColumnSpan="2" Name="LViewShoes" ScrollViewer.HorizontalScrollBarVisibility="Hidden" Margin="5">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="5"
                            Background="#FFF" Margin="5" Padding="10" Width="1000">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="5, 0, 15, 0">
                                <Border Width="80" Height="80" BorderBrush="#AAA"
                                    BorderThickness="1" Background="#AAA">
                                    <Image Name="ImgPreview" Stretch="UniformToFill" Source="{Binding ImageSource}"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontSize="14" FontWeight="Bold">
                                    <Run Text="{Binding Title}"/>
                                </TextBlock>
                                <TextBlock FontSize="10">
                                    <Run Text="{Binding Description}"/>
                                    <Run Text=" | Остаток на складе:"/>
                                    <Run Text="{Binding Stock}"/>
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{Binding Price, StringFormat={}{0:N0} ₽}"
                                       FontSize="18" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="15, 0">
                                <Button Name="BtnBuy" Content="Добавить в корзину" Padding="12, 6" Click="BtnBuy_Click" Tag="{Binding}"/>
                                <Button Name="BtnEdit" Content="✎" Padding="8,4" Margin="5,0,0,0" ToolTip="Редактировать" 
                                        Click="BtnEdit_Click" Tag="{Binding}" 
                                        Visibility="{Binding DataContext.AdminVisibility, RelativeSource={RelativeSource AncestorType=Page}}"/>
                                <Button Name="BtnDelete" Content="❌" Padding="8,4" Margin="5,0,0,0" ToolTip="Удалить" 
                                        Click="BtnDelete_Click" Tag="{Binding}" 
                                        Visibility="{Binding DataContext.AdminVisibility, RelativeSource={RelativeSource AncestorType=Page}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
