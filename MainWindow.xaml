<Window x:Class="SorokonozkaApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SorokonozkaApp"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Title="SorokonozkaApp" Height="1080" Width="1920">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Content.Title, ElementName=FrameMain}" VerticalAlignment="Center"
                   HorizontalAlignment="Center" FontSize="26" Margin="5"/>
        <Frame x:Name="FrameMain" Grid.Row="1" NavigationUIVisibility="Hidden" Margin="5"
               Navigated="FrameMain_Navigated"/>
        <TextBlock Grid.Row="2" Text="Нечаев Максим ИСП-43" VerticalAlignment="Center"
                   HorizontalAlignment="Right" FontSize="10" Margin="5"/>
    </Grid>
</Window>
